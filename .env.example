# Dashboard server-side fetch target. In production this should be the
# Cloudflare Access protected tunnel hostname.
METRICS_API_URL=https://vps1-metrics.harshsandhu.com/metrics
METRICS_API_TOKEN=replace-with-a-long-random-token

# Required when the metrics tunnel hostname is protected by Cloudflare Access
# Service Auth.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Local VPS agent defaults.
AGENT_HOST=127.0.0.1
AGENT_PORT=4317
AGENT_DISK_MOUNT=/
AGENT_SAMPLE_INTERVAL_MS=5000
AGENT_MAX_HISTORY=180
